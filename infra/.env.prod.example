# Copie para .env na VPS antes de subir:
#   cp infra/.env.prod.example .env

# Porta HTTP da API na VPS
API_PORT=5000

# Backend Auth & Invite Gate (TROQUE TODOS OS SEGREDOS ABAIXO!)
ASPNETCORE_ENVIRONMENT=Production
JWT_ISSUER=jdisc-api
JWT_AUDIENCE=jdisc-client
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria-com-pelo-menos-32-caracteres
INVITE_CODE=TROQUE-SEU-CODIGO-DE-CONVITE

# PostgreSQL (uso interno apenas, não exposto na internet)
POSTGRES_USER=jdisc
POSTGRES_PASSWORD=troque-por-uma-senha-forte-do-postgres
POSTGRES_DB=jdisc

# LiveKit SFU (TROQUE API KEY/SECRET E COLOQUE O IP PÚBLICO DA SUA VPS!)
LIVEKIT_API_KEY=APIjdiscProdKey01
LIVEKIT_API_SECRET=troque-por-um-secret-livekit-com-pelo-menos-32-caracteres
LIVEKIT_PUBLIC_URL=ws://SEU_IP_DA_VPS:7880
