# jdisc Environment Configuration (Copy to .env and customize)

# Backend Auth & Invite Gate
ASPNETCORE_ENVIRONMENT=Development
JWT_ISSUER=jdisc-api
JWT_AUDIENCE=jdisc-client
JWT_SECRET=replace-with-at-least-32-bytes-long-secret-key-for-jdisc-jwt
INVITE_CODE=JDISC-FRIENDS-2026

# PostgreSQL
POSTGRES_USER=jdisc
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=jdisc
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# LiveKit SFU (Self-Hosted)
LIVEKIT_API_KEY=APIjdiscLocalKey01
LIVEKIT_API_SECRET=SecretjdiscLocalKeyMustBeAtLeast32CharsLong01
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_INTERNAL_HTTP_URL=http://livekit:7880

# Frontend Default Server URL
VITE_DEFAULT_SERVER_URL=http://localhost:5000
